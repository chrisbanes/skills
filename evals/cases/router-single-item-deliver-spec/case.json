{
  "id": "router-single-item-deliver-spec",
  "title": "One named issue routes to deliver-issue rather than a scope controller",
  "family": "workflow",
  "target_skills": [
    "deliver-issue"
  ],
  "expected_skills": [
    "deliver-issue"
  ],
  "task_mode": "edit",
  "kind": "routing",
  "fixture": "workflow",
  "allowed_write_paths": [
    ".scratch/review-decisions.json"
  ],
  "forbidden_command_patterns": [
    "\\b(?:gh|git)\\s+(?:api|issue|pr|project|push|fetch|pull)\\b"
  ],
  "validators": [
    {
      "argv": [
        "python3",
        "@validators/pr_review_decisions.py",
        "router-single-item-deliver-spec"
      ],
      "timeout_seconds": 30
    }
  ],
  "rubric": [
    {
      "id": "single-item",
      "text": "Selects deliver-issue for one approved item; neither selects a scope nor invokes run-project/run-project. Reuses approval and plan, retains independent final review."
    }
  ],
  "provenance": {
    "kind": "synthetic"
  }
}

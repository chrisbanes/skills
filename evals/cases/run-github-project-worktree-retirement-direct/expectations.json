{
  "decisions": {
    "merged": {
      "porcelain": [
        "?? scratch/notes.md",
        "?? build-debug.log"
      ],
      "checkout": "retire",
      "branch": "delete",
      "checkout_readback": "inventory-absent"
    },
    "no-change-worker": {
      "return": "no-change",
      "push": false,
      "open_pr": false,
      "shepherd": false
    },

      "complete": true
    },
    "unknown-done": {
      "checkout": "retain",
      "branch": "keep",
      "complete": false
    },
    "different-head": {
      "checkout": "retain",
      "branch": "keep",
      "complete": false
    },
    "unknown-transport": {
      "checkout": "retain",
      "branch": "keep",
      "complete": false
    },
    "unknown-retirement": {
      "checkout": "reconcile-before-retry",

{
  "id": "grounded-writing-email-novel",
  "title": "Write a nontechnical scheduling email",
  "family": "writing",
  "target_skills": [
    "grounded-writing"
  ],
  "expected_skills": [
    "grounded-writing"
  ],
  "task_mode": "edit",
  "kind": "novel",
  "fixture": "text",
  "allowed_write_paths": [
    "draft.md"
  ],
  "validators": [
    {
      "argv": [
        "python3",
        "@validators/text_case.py",

{
  "files": [],
  "file_globs": [
    {
      "pattern": ".scratch/to-plan/*.md",
      "count": 1,
      "must_match": [
        "<!-- to-plan:conversation-plan:v1 id=[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12} -->"
      ],
      "must_contain": [
        "## Planning decisions",
        "## Implementation slices",
        "**Task ID:**",
        "**Depends on:**",
        "report_publisher.py",
        "publish_report",
        "report_config.json",
        "staging_mount",
        "/runtime/reports/staging",
        "published_mount",
        "/runtime/reports/published",
        "write_bytes",
        "os.replace",
        "mark_published",
        "target runtime",
        "re-plan"
      ]
    }
  ],
  "task_graph": {
    "required_edges": [["T2", "T1"]],
    "require_acyclic": true
  }
}

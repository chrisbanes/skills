{
  "files": [],
  "file_globs": [
    {
      "pattern": ".scratch/to-plan/*.md",
      "count": 1,
      "must_match": [
        "<!-- to-plan:conversation-plan:v1 id=[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12} -->"
      ],
      "must_contain": [
        "# Quote missing validator files",
        "## Implementation context",
        "## Implementation slices",
        "**Files and symbols:**",
        "**Test:**",
        "**Validate:**",
        "## Final validation",
        "validator.py",
        "missing_file_error",
        "tests/test_validator.py",
        "**Task graph and parallelism:**",
        "**Task ID:**",
        "**Depends on:**",
        "acyclic"
      ]
    }
  ],
  "task_graph": {
    "required_edges": [
      [
        "T2",
        "T1"
      ]
    ],
    "require_acyclic": true
  }
}

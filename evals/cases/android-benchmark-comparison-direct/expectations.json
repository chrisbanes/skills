{
  "files": ["comparison.md"],
  "must_match": ["(?i)build", "(?i)raw", "(?i)trace", "(?i)(?:variab|spread|consisten.{0,160}(?:quantif|does not (?:establish|isolate|support)|cannot be assessed))", "(?i)completed", "(?i)controlled", "(?i)(?:not (?:provided|supplied|attached|included)|does not include|missing|unavailable|absent|contains?\\s+no\\s+(?:the\\s+)?raw\\s+results?\\s+or\\s+traces?|contains?\\s+neither\\s+(?:the\\s+)?raw\\s+results?\\s+nor\\s+traces?)"],
  "must_not_match": [

{
  "files": [
    "state.md"
  ],
  "must_contain": [
    "Immutable evaluation state",
    "controller owns"
  ],
  "file_globs": [
    {
      "pattern": ".scratch/decision.md",
      "count": 1,
      "must_match": [
        "^Active: https://tracker\\.example\\.test/items/OPS\\-31/records/2$",
        "^Digest: de3f0ec43bb1c5828c7e38e9ec45ba8c1afa3998b1569fd4cb28b02552cb823c$",
        "^Presentation: warning$",
        "^Next: no\\-op$",
        "^Fork: blocked$",
        "^Gap: blocked$",
        "^Foreign: blocked$",
        "^Tampered: blocked$"
      ],
      "must_not_match": [
        "^Active: (?!https://tracker\\.example\\.test/items/OPS\\-31/records/2$).*$",
        "^Digest: (?!de3f0ec43bb1c5828c7e38e9ec45ba8c1afa3998b1569fd4cb28b02552cb823c$).*$",
        "^Presentation: (?!warning$).*$",
        "^Next: (?!no\\-op$).*$",
        "^Fork: (?!blocked$).*$",
        "^Gap: (?!blocked$).*$",
        "^Foreign: (?!blocked$).*$",
        "^Tampered: (?!blocked$).*$"
      ]
    }
  ]
}
